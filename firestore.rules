// Production Firestore Security Rules
// Bu kuralları Firebase Console > Firestore Database > Rules sekmesine yapıştırın

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products koleksiyonu - Herkes okuyabilir, yazma için authentication gerekli
    match /products/{productId} {
      // Herkes ürünleri okuyabilir
      allow read: if true;
      
      // Product Manager email kontrolü
      function isProductManager() {
        return request.auth != null && request.auth.token.email == 'mbozyel2003@gmail.com';
      }
      
      // Admin UID kontrolü
      function isAdmin() {
        return request.auth != null && request.auth.uid == 'kcopWa6L3AZ5BbeHCokV7uKD6Pd2';
      }
      
      // Yazma için admin veya product manager gerekli
      allow write: if isAdmin() || isProductManager();
    }
    
    // Users koleksiyonu - Kullanıcılar sadece kendi verilerini okuyup yazabilir
    match /users/{userId} {
      // Admin UID (admin tüm kullanıcıları görebilir ve güncelleyebilir)
      function isAdmin() {
        return request.auth != null && request.auth.uid == 'kcopWa6L3AZ5BbeHCokV7uKD6Pd2';
      }
      
      // Sales Manager email kontrolü
      function isSalesManager() {
        return request.auth != null && request.auth.token.email == 'mbozyel349@gmail.com';
      }
      
      // Product Manager email kontrolü
      function isProductManager() {
        return request.auth != null && request.auth.token.email == 'mbozyel2003@gmail.com';
      }
      
      // Kullanıcılar kendi dokümanlarını okuyabilir, admin, sales manager ve product manager tüm kullanıcıları okuyabilir
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isSalesManager() || isProductManager());
      
      // Kullanıcılar kendi dokümanlarını oluşturabilir
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Kullanıcılar kendi dokümanlarını güncelleyebilir, admin, sales manager ve product manager tüm kullanıcıları güncelleyebilir
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin() || isSalesManager() || isProductManager());
    }
    
    // Orders koleksiyonu
    match /orders/{orderId} {
      // Admin UID (admin tüm order'ları görebilir)
      function isAdmin() {
        return request.auth != null && request.auth.uid == 'kcopWa6L3AZ5BbeHCokV7uKD6Pd2';
      }
      
      // Sales Manager email kontrolü
      function isSalesManager() {
        return request.auth != null && request.auth.token.email == 'mbozyel349@gmail.com';
      }
      
      // Product Manager email kontrolü
      function isProductManager() {
        return request.auth != null && request.auth.token.email == 'mbozyel2003@gmail.com';
      }
      
      // Kullanıcılar kendi order'larını okuyabilir, admin, sales manager ve product manager tüm order'ları okuyabilir
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin() || isSalesManager() || isProductManager());
      
      // Kullanıcılar kendi order'larını oluşturabilir (checkout sırasında)
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      
      // Admin, sales manager ve product manager order'ları güncelleyebilir
      // Kullanıcılar sadece kendi order'larını cancelled durumuna güncelleyebilir (sadece processing'den cancelled'a)
      allow update: if isAdmin() || isSalesManager() || isProductManager() ||
        (request.auth != null && 
         request.auth.uid == resource.data.userId && 
         request.resource.data.status == 'cancelled' &&
         resource.data.status == 'processing');
    }
    
    // Cart koleksiyonu (gelecekte kullanılacak)
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reviews/Ratings koleksiyonu (gelecekte kullanılacak)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Live Chats koleksiyonu
    match /liveChats/{chatId} {
      // Support Agent email kontrolü
      function isSupportAgent() {
        return request.auth != null && request.auth.token.email == 'mbzyl349@gmail.com';
      }
      
      // Müşteri kendi chat'ini okuyabilir, support agent tüm chat'leri okuyabilir
      // Guest kullanıcılar için: customerId == 'guest' olan chat'leri okuyabilir
      allow read: if (
        isSupportAgent() ||
        (request.auth != null && resource.data.customerId == request.auth.uid) ||
        (request.auth != null && resource.data.customerId == 'guest') ||
        (request.auth == null && resource.data.customerId == 'guest')
      );
      
      // Müşteri kendi chat'ini oluşturabilir (guest için de, auth olmadan)
      allow create: if true;
      
      // Müşteri kendi chat'ine mesaj ekleyebilir, support agent tüm chat'lere mesaj ekleyebilir
      // Guest kullanıcılar için: customerId == 'guest' olan chat'lere mesaj ekleyebilir
      allow update: if (
        isSupportAgent() ||
        (request.auth != null && resource.data.customerId == request.auth.uid) ||
        (request.auth != null && resource.data.customerId == 'guest') ||
        (request.auth == null && resource.data.customerId == 'guest')
      );
      
      // Sadece support agent chat'i silebilir
      allow delete: if isSupportAgent();
    }
    
    // Diğer tüm koleksiyonlar için varsayılan: Reddet
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

